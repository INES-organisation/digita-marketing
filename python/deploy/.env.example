# Copier vers python/deploy/.env sur le VPS (fichier non versionné).
DATABASE_URL=postgresql+psycopg2://digita:CHANGER_MOI@ines-postgres:5432/digita
APP_URL=https://digita.buzz
ADMIN_EMAIL=admin@digita.fr
INES_NETWORK=ines_ines-network
# Envoi des e-mails (demande d'audit). Sans MAIL_HOST, les e-mails sont seulement journalisés.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@digita-marketing.com
# Pont INES : clé API INES « professional » du compte qui reçoit les leads (INES → Clés API).
# Avec cette clé, audits, inscriptions, rendez-vous et briefs projet sont copiés dans le CRM INES
# (tag DIGITA) et le chatbot passe par la passerelle IA d'INES : OPENAI_API_KEY devient inutile.
INES_API_URL=http://ines-backend:8000
INES_API_KEY=
INES_AI_MODEL=
# Chatbot et outils IA. Sans clé, le chatbot donne ses réponses de secours (comme le PHP).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
# Paiement des formations. Sans STRIPE_SECRET_KEY, le site affiche « paiement pas encore configuré ».
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# Génération de sites par Webox (admin → projets → « Générer »). Sans valeur, l'adresse par défaut du PHP
# (http://localhost:8000) pointe sur le conteneur Digita lui-même : la génération échoue proprement.
WEBOX_API_URL=
WEBOX_API_KEY=
