# Copier vers python/deploy/.env sur le VPS (fichier non versionné).
DATABASE_URL=postgresql+psycopg2://digita:CHANGER_MOI@ines-postgres:5432/digita
APP_URL=https://digita.buzz
ADMIN_EMAIL=admin@digita.fr
INES_NETWORK=ines_ines-network
# INES gère Digita : clé API INES « professional » d'un compte admin (INES → Clés API).
# Avec cette clé : leads copiés dans le CRM INES (tag DIGITA), chatbot et outils IA via la passerelle
# IA d'INES, e-mails envoyés par le fournisseur d'INES. Sans clé : ni IA (réponses de secours) ni e-mails.
INES_API_URL=http://ines-backend:8000
INES_API_KEY=
INES_AI_MODEL=
# Expéditeur des e-mails (facultatif, à déclarer chez le fournisseur d'INES) — sinon celui d'INES.
MAIL_FROM=
# Tâches planifiées appelées par INES (newsletter, séquences après achat) : même valeur que
# PROJECT_CRON_TOKEN dans le .env.production d'INES. Signe aussi les liens de désabonnement.
PROJECT_CRON_TOKEN=
# Paiement des formations : Stripe d'INES (/admin/integrations), via /api/v1/external/stripe/… —
# aucune clé Stripe ici, aucun webhook propre à Digita (réconciliation nocturne à la place).
# Génération de sites par Webox (admin → projets → « Générer »). Sans valeur, l'adresse par défaut du PHP
# (http://localhost:8000) pointe sur le conteneur Digita lui-même : la génération échoue proprement.
WEBOX_API_URL=
WEBOX_API_KEY=
