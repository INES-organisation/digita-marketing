# Copier vers python/deploy/.env sur le VPS (fichier non versionné).
DATABASE_URL=postgresql+psycopg2://digita:CHANGER_MOI@ines-postgres:5432/digita
APP_URL=https://digita.buzz
# Clé de signature des cookies de session : `python3 -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=CHANGER_MOI
ADMIN_EMAIL=admin@digita.fr
INES_NETWORK=ines_ines-network
# Envoi des e-mails (demande d'audit). Sans MAIL_HOST, les e-mails sont seulement journalisés.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@digita-marketing.com
# Chatbot et outils IA. Sans clé, le chatbot donne ses réponses de secours (comme le PHP).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
